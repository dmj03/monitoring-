# AI analyst summary (POST /investigate/summary).
# Copy to .env in this folder and fill in the key. .env is gitignored.
# Without a key the AI summary reports "unavailable"; everything else works.
OPENAI_API_KEY=
LLM_MODEL=gpt-5-mini

# Adding alerts (POST /alerts and the "Add alert" button) is frozen by default.
# Set to "on" to enable it again. Restart uvicorn after changing it.
UC3_ALERT_CREATION=
